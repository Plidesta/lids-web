# Konfigurasi Lingkungan E-Commerce Aksara Berdampak Unsulbar
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/project-aksara-web/public

# Pilihan Driver Database: 'sqlite' (Lokal / Simple) atau 'mysql' (Hosting cPanel / XAMPP)
DB_DRIVER=sqlite

# Jika menggunakan MySQL di Hosting / XAMPP, sesuaikan data berikut:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aksara_unsulbar
DB_USERNAME=root
DB_PASSWORD=

# Hotline Nomor WhatsApp Kurir Mahasiswa (format internasional, cth: 62821...)
COURIER_PHONE=6282190001234
